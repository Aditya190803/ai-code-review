{
  "name": "ai-code-review",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "ai-review": "./dist/app.js"
  },
  "scripts": {
    "dev": "bun run app.tsx",
    "build": "bun build app.tsx --outdir=dist --target=node",
    "lint": "vp lint && tsc --noEmit",
    "test": "bun test",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:start": "bun run --cwd web start",
    "web:lint": "bun run --cwd web lint",
    "prepare": "vp config"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.0",
    "@types/react": "^19.3.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "ai": "^7.0.99",
    "clipboardy": "^5.3.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.3",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "simple-git": "^3.32.2",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.2"
  }
}
