# Copy to .env and fill in the provider you use. Never commit .env.

# ── Default provider: OpenCode Zen (model: big-pickle) ──
# OpenAI-compatible endpoint at https://opencode.ai/zen/v1
OPENCODE_API_KEY=

# Optional: point the OpenCode client at a proxy or self-hosted gateway.
# Defaults to https://opencode.ai/zen/v1 when unset.
OPENCODE_BASE_URL=

# Generic fallback key, also honored by the OpenCode provider.
AI_CODE_REVIEW_API_KEY=

# ── Optional alternative API-key providers ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Optional: override the model for whichever provider is selected.
AI_MODEL=
